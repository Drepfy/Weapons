# ============================================================
#  SCOREBOARD - sidebar with money, playtime, kills, deaths, IP
#  Requires SkBee.
# ============================================================

# Playtime is counted in minutes in {economy::playtime::<uuid>}
every 1 minute:
    loop all players:
        add 1 to {economy::playtime::%uuid of loop-player%}

function fmtPlaytime(m: number) :: text:
    set {_h} to floor({_m} / 60)
    set {_min} to mod({_m}, 60)
    return "%{_h}%h %{_min}%m"

function updateBoard(p: player):
    set {_u} to uuid of {_p}
    set {_kills} to {economy::kills::%{_u}%} ? 0
    set {_deaths} to {economy::deaths::%{_u}%} ? 0
    if {_deaths} > 0:
        set {_kd} to {_kills} / {_deaths}
    else:
        set {_kd} to {_kills}
    # online count leaves out vanished staff this player can't see
    set {_online} to 0
    loop all players:
        if {_p} can see loop-player:
            add 1 to {_online}
    set {_reset} to fmtDuration(({marketstate::next-reset} ? 0) - (unix timestamp of now))
    set {_footer} to {cfg::scoreboard-footer} ? "&7discord.gg/zhVxs8prtn"

    set title of {_p}'s fastboard to {cfg::title} ? "&b&lᴠᴀɴɪʟʟᴀ sᴍᴘ"
    set line 1 of {_p}'s fastboard to "&r"
    set line 2 of {_p}'s fastboard to "&b&lʏᴏᴜ"
    set line 3 of {_p}'s fastboard to " &8▪ &fMoney &a%money(getBalance({_p}))%"
    set line 4 of {_p}'s fastboard to " &8▪ &fKills &a%{_kills}% &8┃ &fDeaths &c%{_deaths}%"
    set line 5 of {_p}'s fastboard to " &8▪ &fK/D &e%{_kd}%"
    set line 6 of {_p}'s fastboard to " &8▪ &fPlaytime &e%fmtPlaytime({economy::playtime::%{_u}%} ? 0)%"
    set line 7 of {_p}'s fastboard to " &8▪ &fMultiplier &a%multiplier({_p})%x"
    set line 8 of {_p}'s fastboard to "&r&r"
    set line 9 of {_p}'s fastboard to "&3&lsᴇʀᴠᴇʀ"
    set line 10 of {_p}'s fastboard to " &8▪ &fOnline &a%{_online}%"
    set line 11 of {_p}'s fastboard to " &8▪ &fMarket reset &e%{_reset}%"
    set line 12 of {_p}'s fastboard to "&r&r&r"
    set line 13 of {_p}'s fastboard to {_footer}

on join:
    wait 1 tick
    updateBoard(player)

every 2 seconds:
    loop all players:
        updateBoard(loop-player)
