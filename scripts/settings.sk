# ============================================================
#  SETTINGS - every option for the server scripts lives here.
#  After editing, run: /sk reload settings
#
#  Colors: use & codes (&a, &l ...) and <##RRGGBB> for hex colors.
# ============================================================

on load:
    delete {cfg::*}

    # --- General ---
    set {cfg::server-ip} to "85.10.193.117:25427"
    # Scoreboard title (VANILLA SMP gradient)
    set {cfg::title} to "<##00D6FF>&lᴠ<##14D5FF>&lᴀ<##28D5FF>&lɴ<##3DD4FF>&lɪ<##51D3FF>&lʟ<##65D3FF>&lʟ<##79D2FF>&lᴀ <##A2D0FF>&ls<##B6D0FF>&lᴍ<##CACFFF>&lᴘ"
    set {cfg::currency} to "$"
    # Prefix in front of every chat message
    set {cfg::prefix} to "<##00D6FF>&lꜱᴍᴘ &8» &7"
    set {cfg::starting-balance} to 0

    # --- PvP ---
    # Money for killing another player (0 = off)
    set {cfg::player-kill-reward} to 50
    # Money taken from the player who died in PvP (0 = off)
    set {cfg::player-death-penalty} to 0

    # --- Rank multipliers (kill rewards) ---
    # Give a player the permission smp.multiplier.<name> to use it. Highest wins.
    set {cfg::multiplier::vip} to 1.5
    set {cfg::multiplier::mvp} to 2
    set {cfg::multiplier::elite} to 3

    # --- Mob rewards: {mobreward::<mob type>} = money per kill ---
    # Mobs not listed here pay nothing.
    delete {mobreward::*}
    set {mobreward::zombie} to 5
    set {mobreward::skeleton} to 5
    set {mobreward::spider} to 4
    set {mobreward::creeper} to 8
    set {mobreward::enderman} to 15
    set {mobreward::blaze} to 12
    set {mobreward::wither skeleton} to 20
    set {mobreward::witch} to 10
    set {mobreward::piglin brute} to 25
    set {mobreward::wither} to 500
    set {mobreward::ender dragon} to 1000

    # --- Market ---
    set {cfg::market-title} to "&2&lᴍᴀʀᴋᴇᴛ"
    # Minutes between market resets (stock refills, rotation re-rolls)
    set {cfg::market-reset-minutes} to 60
    # Broadcast when the market resets (delete this line for no message)
    set {cfg::market-reset-message} to "&2&lᴍᴀʀᴋᴇᴛ &7has reset! Stock refilled - &a/market"
    # Rotation: true = every reset shows random items from the list below
    #           false = always show every enabled item in its slot
    set {cfg::market-rotate} to false
    # How many random items to show when rotation is on (max 30)
    set {cfg::market-rotate-count} to 12

    # marketItem(id, item, display name, amount, price, stock, slot, enabled)
    #   amount = items given per click (1)
    #   stock  = how many can be bought per reset (-1 = unlimited)
    #   slot   = where it shows (rows 2-5 = slots 9-44). Ignored when rotation is on.
    delete {market::*}
    marketItem("golden_carrot", golden carrot, "&6Golden Carrot", 1, 5, 64, 9, true)
    marketItem("xp_bottle", experience bottle, "&aBottle o' Enchanting", 1, 15, 64, 10, true)
    marketItem("diamond", diamond, "&bDiamond", 1, 300, 32, 11, true)
    marketItem("slime_ball", slime ball, "&aSlime Ball", 1, 5, 64, 12, true)
    marketItem("totem", totem of undying, "&eTotem of Undying", 1, 1500, 3, 13, true)
    marketItem("blaze_rod", blaze rod, "&6Blaze Rod", 1, 20, 32, 14, true)
    marketItem("gold_block", gold block, "&eGold Block", 1, 250, 16, 15, true)
    marketItem("nether_star", nether star, "&fNether Star", 1, 5000, 1, 16, true)
    marketItem("iron_block", iron block, "&fIron Block", 1, 120, 32, 17, true)
    marketItem("nether_wart", nether wart, "&cNether Wart", 1, 3, 64, 18, true)
    marketItem("upgrade_template", netherite upgrade smithing template, "&dNetherite Upgrade Template", 1, 1500, 3, 19, true)
    marketItem("netherite_ingot", netherite ingot, "&8Netherite Ingot", 1, 2000, 4, 20, true)
    marketItem("ancient_debris", ancient debris, "&6Ancient Debris", 1, 800, 8, 21, true)
    marketItem("enchanted_golden_apple", enchanted golden apple, "&dEnchanted Golden Apple", 1, 3000, 2, 22, true)
    marketItem("obsidian", obsidian, "&5Obsidian", 1, 10, 64, 23, true)
    marketItem("shulker_shell", shulker shell, "&dShulker Shell", 1, 450, 8, 24, true)
    marketItem("steak", cooked beef, "&6Steak", 1, 3, 64, 25, true)
    marketItem("diamond_block", diamond block, "&bDiamond Block", 1, 2700, 8, 26, true)
    marketItem("golden_apple", golden apple, "&6Golden Apple", 1, 100, 32, 27, true)
    marketItem("breeze_rod", breeze rod, "&bBreeze Rod", 1, 60, 16, 28, true)
    marketItem("wither_skull", wither skeleton skull, "&8Wither Skeleton Skull", 1, 1000, 3, 29, true)
    marketItem("oak_log", oak log, "&6Oak Log", 1, 2, 64, 30, true)
    marketItem("netherite_scrap", netherite scrap, "&8Netherite Scrap", 1, 500, 8, 31, true)
    marketItem("gunpowder", gunpowder, "&7Gunpowder", 1, 5, 64, 32, true)
    marketItem("leather", leather, "&6Leather", 1, 8, 64, 33, true)
    marketItem("glowstone", glowstone, "&eGlowstone", 1, 10, 64, 34, true)
    marketItem("cobweb", cobweb, "&fCobweb", 1, 25, 32, 35, true)
    marketItem("piston", piston, "&7Piston", 1, 30, 16, 39, true)
    marketItem("dragon_breath", dragon's breath, "&dDragon's Breath", 1, 400, 8, 40, true)
    marketItem("ominous_key", ominous trial key, "&5Ominous Trial Key", 1, 2500, 2, 41, true)

function marketItem(id: text, item: itemtype, name: text, amount: integer, price: number, stock: integer, slot: integer, enabled: boolean):
    add {_id} to {market::ids::*}
    set {market::%{_id}%::item} to {_item}
    set {market::%{_id}%::name} to {_name}
    set {market::%{_id}%::amount} to {_amount}
    set {market::%{_id}%::price} to {_price}
    set {market::%{_id}%::stock} to {_stock}
    set {market::%{_id}%::slot} to {_slot}
    set {market::%{_id}%::enabled} to {_enabled}
