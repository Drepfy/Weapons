# ============================================================
#  SETTINGS - every option for the server scripts lives here.
#  After editing, run: /sk reload settings
#
#  Colors: use & codes (&a, &l ...) and <##RRGGBB> for hex colors.
# ============================================================

on load:
    delete {cfg::*}

    # --- General ---
    set {cfg::server-ip} to "85.10.193.117:25427"
    # Scoreboard title (VANILLA SMP gradient)
    set {cfg::title} to "<##00D6FF>&lᴠ<##14D5FF>&lᴀ<##28D5FF>&lɴ<##3DD4FF>&lɪ<##51D3FF>&lʟ<##65D3FF>&lʟ<##79D2FF>&lᴀ <##A2D0FF>&ls<##B6D0FF>&lᴍ<##CACFFF>&lᴘ"
    set {cfg::currency} to "$"
    # Prefix in front of every chat message
    set {cfg::prefix} to "<##00D6FF>&lꜱᴍᴘ &8» &7"
    set {cfg::starting-balance} to 0

    # --- PvP ---
    # Money for killing another player (0 = off)
    set {cfg::player-kill-reward} to 50
    # Money taken from the player who died in PvP (0 = off)
    set {cfg::player-death-penalty} to 0

    # --- Mob rewards: {mobreward::<mob type>} = money per kill ---
    # Mobs not listed here pay nothing.
    delete {mobreward::*}
    set {mobreward::zombie} to 5
    set {mobreward::skeleton} to 5
    set {mobreward::spider} to 4
    set {mobreward::creeper} to 8
    set {mobreward::enderman} to 15
    set {mobreward::blaze} to 12
    set {mobreward::wither skeleton} to 20
    set {mobreward::witch} to 10
    set {mobreward::piglin brute} to 25
    set {mobreward::wither} to 500
    set {mobreward::ender dragon} to 1000

    # --- Market ---
    set {cfg::market-title} to "&2&lᴍᴀʀᴋᴇᴛ"
    # Minutes between market resets (stock refills, rotation re-rolls)
    set {cfg::market-reset-minutes} to 60
    # Broadcast when the market resets (delete this line for no message)
    set {cfg::market-reset-message} to "&2&lᴍᴀʀᴋᴇᴛ &7has reset! Stock refilled - &a/market"
    # Rotation: true = every reset shows random items from the list below
    #           false = always show every enabled item in its slot
    set {cfg::market-rotate} to false
    # How many random items to show when rotation is on (max 28)
    set {cfg::market-rotate-count} to 12

    # Every item sells at least 3 per purchase, except these:
    set {cfg::market-min-amount} to 3
    set {cfg::market-min-exempt::*} to "enchanted_golden_apple" and "netherite_ingot"

    # marketItem(id, item, display name, amount, price, stock, slot, enabled)
    #   stock = how many times it can be bought per reset (-1 = unlimited)
    #   slot  = where it shows (rows 2-5: 10-16, 19-25, 28-34, 37-43). Ignored when rotation is on.
    delete {market::*}
    marketItem("echo_shard", echo shard, "&3Echo Shard", 3, 450, 16, 10, true)
    marketItem("ghast_tear", ghast tear, "&fGhast Tear", 3, 225, 16, 11, true)
    marketItem("golden_carrot", golden carrot, "&6Golden Carrot", 16, 60, 20, 12, true)
    marketItem("xp_bottle", experience bottle, "&aBottle o' Enchanting", 16, 200, 10, 13, true)
    marketItem("diamond", diamond, "&bDiamond", 3, 900, 32, 14, true)
    marketItem("emerald_block", emerald block, "&aEmerald Block", 3, 1350, 16, 15, true)
    marketItem("slime_ball", slime ball, "&aSlime Ball", 16, 40, 20, 16, true)
    marketItem("totem", totem of undying, "&eTotem of Undying", 3, 4500, 3, 19, true)
    marketItem("blaze_rod", blaze rod, "&6Blaze Rod", 8, 120, 20, 20, true)
    marketItem("ender_pearl", ender pearl, "&3Ender Pearl", 16, 250, 20, 21, true)
    marketItem("gold_block", gold block, "&eGold Block", 3, 750, 16, 22, true)
    marketItem("nether_star", nether star, "&fNether Star", 3, 15000, 1, 23, true)
    marketItem("iron_block", iron block, "&fIron Block", 3, 360, 32, 24, true)
    marketItem("nether_wart", nether wart, "&cNether Wart", 16, 40, 20, 25, true)
    marketItem("upgrade_template", netherite upgrade smithing template, "&dNetherite Upgrade Template", 3, 4500, 3, 28, true)
    marketItem("shulker_shell", shulker shell, "&dShulker Shell", 4, 1800, 8, 29, true)
    marketItem("obsidian", obsidian, "&5Obsidian", 8, 80, 20, 30, true)
    marketItem("enchanted_golden_apple", enchanted golden apple, "&dEnchanted Golden Apple", 1, 3000, 2, 31, true)
    marketItem("ancient_debris", ancient debris, "&6Ancient Debris", 3, 2400, 8, 32, true)
    marketItem("netherite_ingot", netherite ingot, "&8Netherite Ingot", 1, 2000, 4, 33, true)
    marketItem("arrow", arrow, "&fArrow", 32, 100, 20, 37, true)
    marketItem("cooked_beef", cooked beef, "&6Steak", 32, 80, 32, 38, true)
    marketItem("end_crystal", end crystal, "&dEnd Crystal", 3, 900, 8, 39, true)
    marketItem("firework_rocket", firework rocket, "&cFirework Rocket", 32, 300, 16, 40, true)
    marketItem("diamond_block", diamond block, "&bDiamond Block", 3, 2700, 8, 41, true)
    marketItem("lapis_block", lapis lazuli block, "&9Lapis Block", 8, 400, 16, 42, true)
    marketItem("redstone_block", redstone block, "&cRedstone Block", 16, 320, 16, 43, true)
    marketItem("golden_apple", golden apple, "&6Golden Apple", 3, 300, 32, 34, true)

function marketItem(id: text, item: itemtype, name: text, amount: integer, price: number, stock: integer, slot: integer, enabled: boolean):
    add {_id} to {market::ids::*}
    set {market::%{_id}%::item} to {_item}
    set {market::%{_id}%::name} to {_name}
    set {market::%{_id}%::amount} to {_amount}
    if {cfg::market-min-exempt::*} does not contain {_id}:
        set {market::%{_id}%::amount} to max({_amount}, {cfg::market-min-amount} ? 3)
    set {market::%{_id}%::price} to {_price}
    set {market::%{_id}%::stock} to {_stock}
    set {market::%{_id}%::slot} to {_slot}
    set {market::%{_id}%::enabled} to {_enabled}
