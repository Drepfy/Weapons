# ============================================================
#  VANILLA SMP - every script in one file
#  Requires Skript 2.7+ and SkBee. Put ONLY this file in plugins/Skript/scripts/
#  (delete the separate settings/economy/market/... .sk files first!)
# ============================================================


# ============================================================
#  SETTINGS - every option for the server scripts lives here.
#  After editing, run: /sk reload settings
#
#  Colors: use & codes (&a, &l ...) and <##RRGGBB> for hex colors.
# ============================================================

on load:
    delete {cfg::*}

    # --- General ---
    set {cfg::server-ip} to "85.10.193.117:25427"
    # Scoreboard title (VANILLA SMP gradient)
    set {cfg::title} to "<##00D6FF>&lᴠ<##14D5FF>&lᴀ<##28D5FF>&lɴ<##3DD4FF>&lɪ<##51D3FF>&lʟ<##65D3FF>&lʟ<##79D2FF>&lᴀ <##A2D0FF>&ls<##B6D0FF>&lᴍ<##CACFFF>&lᴘ"
    set {cfg::currency} to "$"
    # Prefix in front of every chat message
    set {cfg::prefix} to "<##00D6FF>&lꜱᴍᴘ &8» &7"
    set {cfg::starting-balance} to 0

    # --- PvP ---
    # Money for killing another player (0 = off)
    set {cfg::player-kill-reward} to 50
    # Money taken from the player who died in PvP (0 = off)
    set {cfg::player-death-penalty} to 0

    # --- Teleports (/tpa /rtp /spawn) ---
    # Seconds to stand still before teleporting (0 = instant). Staff with smp.tp.bypass skip it.
    set {cfg::tp-warmup} to 3
    # Seconds a /tpa request stays valid
    set {cfg::tpa-expire} to 60
    # Cooldowns in seconds
    set {cfg::tpa-cooldown} to 10
    set {cfg::rtp-cooldown} to 300
    set {cfg::spawn-cooldown} to 5
    # /rtp picks a spot this far from 0,0 (blocks)
    set {cfg::rtp-min} to 500
    set {cfg::rtp-max} to 5000
    # World used for /rtp
    set {cfg::rtp-world} to "world"

    # --- Ranks (shown in /ranks, NOT buyable with in-game money) ---
    # Give a rank with /setrank <player> <id> or the permission smp.rank.<id>.
    # Multiply the money you get from mob and player kills.
    set {cfg::store-url} to "discord.gg/zhVxs8prtn"
    # rank(id, display name, multiplier, price shown in /ranks (real money, text), icon)
    delete {cfg::rank::*}
    rank("vip", "&a&lVIP", 1.5, "$5", emerald)
    rank("elite", "&6&lELITE", 3, "$15", nether star)

    # --- Mob rewards: money per kill (1 min - 7 max) ---
    # Mobs not listed here pay nothing.
    delete {mobreward::*}
    set {mobreward::chicken} to 1
    set {mobreward::cow} to 1
    set {mobreward::pig} to 1
    set {mobreward::sheep} to 1
    set {mobreward::rabbit} to 1
    set {mobreward::cod} to 1
    set {mobreward::salmon} to 1
    set {mobreward::squid} to 1
    set {mobreward::zombie} to 2
    set {mobreward::husk} to 2
    set {mobreward::drowned} to 2
    set {mobreward::skeleton} to 2
    set {mobreward::stray} to 2
    set {mobreward::spider} to 2
    set {mobreward::silverfish} to 2
    set {mobreward::slime} to 2
    set {mobreward::magma cube} to 2
    set {mobreward::zombified piglin} to 2
    set {mobreward::creeper} to 3
    set {mobreward::cave spider} to 3
    set {mobreward::zombie villager} to 3
    set {mobreward::phantom} to 3
    set {mobreward::pillager} to 3
    set {mobreward::bogged} to 3
    set {mobreward::endermite} to 3
    set {mobreward::witch} to 4
    set {mobreward::enderman} to 4
    set {mobreward::blaze} to 4
    set {mobreward::guardian} to 4
    set {mobreward::vindicator} to 4
    set {mobreward::hoglin} to 4
    set {mobreward::piglin} to 4
    set {mobreward::wither skeleton} to 5
    set {mobreward::ghast} to 5
    set {mobreward::shulker} to 5
    set {mobreward::breeze} to 5
    set {mobreward::evoker} to 5
    set {mobreward::piglin brute} to 6
    set {mobreward::ravager} to 6
    set {mobreward::warden} to 7
    set {mobreward::elder guardian} to 7
    set {mobreward::wither} to 7
    set {mobreward::ender dragon} to 7

    # --- Market ---
    set {cfg::market-title} to "&2&lᴍᴀʀᴋᴇᴛ"
    # Minutes between market resets (stock refills, rotation re-rolls)
    set {cfg::market-reset-minutes} to 60
    # Broadcast when the market resets (delete this line for no message)
    set {cfg::market-reset-message} to "&2&lᴍᴀʀᴋᴇᴛ &7has reset! Stock refilled - &a/market"
    # Rotation: true = every reset shows random items from the list below
    #           false = always show every enabled item in its slot
    set {cfg::market-rotate} to false
    # How many random items to show when rotation is on (max 30)
    set {cfg::market-rotate-count} to 12

    # marketItem(id, item, display name, amount, price, stock, slot, enabled)
    #   amount = items given per click (1)
    #   stock  = how many can be bought per reset (-1 = unlimited)
    #   slot   = where it shows (inner slots only: 10-16, 19-25, 28-34, 37-43 = 28 items max). Ignored when rotation is on.
    delete {market::*}
    marketItem("golden_carrot", golden carrot, "&6Golden Carrot", 1, 5, 64, 10, true)
    marketItem("xp_bottle", experience bottle, "&aBottle o' Enchanting", 1, 15, 64, 11, true)
    marketItem("diamond", diamond, "&bDiamond", 1, 300, 32, 12, true)
    marketItem("slime_ball", slime ball, "&aSlime Ball", 1, 5, 64, 13, true)
    marketItem("totem", totem of undying, "&eTotem of Undying", 1, 1500, 3, 14, true)
    marketItem("blaze_rod", blaze rod, "&6Blaze Rod", 1, 20, 32, 15, true)
    marketItem("gold_block", gold block, "&eGold Block", 1, 250, 16, 16, true)
    marketItem("nether_star", nether star, "&fNether Star", 1, 5000, 1, 19, true)
    marketItem("iron_block", iron block, "&fIron Block", 1, 120, 32, 20, true)
    marketItem("nether_wart", nether wart, "&cNether Wart", 1, 3, 64, 21, true)
    marketItem("upgrade_template", netherite upgrade smithing template, "&dNetherite Upgrade Template", 1, 1500, 3, 22, true)
    marketItem("netherite_ingot", netherite ingot, "&8Netherite Ingot", 1, 2000, 4, 23, true)
    marketItem("ancient_debris", ancient debris, "&6Ancient Debris", 1, 800, 8, 24, true)
    marketItem("enchanted_golden_apple", enchanted golden apple, "&dEnchanted Golden Apple", 1, 3000, 2, 25, true)
    marketItem("obsidian", obsidian, "&5Obsidian", 1, 10, 64, 28, true)
    marketItem("shulker_shell", shulker shell, "&dShulker Shell", 1, 450, 8, 29, true)
    marketItem("steak", cooked beef, "&6Steak", 1, 3, 64, 30, true)
    marketItem("diamond_block", diamond block, "&bDiamond Block", 1, 2700, 8, 31, true)
    marketItem("golden_apple", golden apple, "&6Golden Apple", 1, 100, 32, 32, true)
    marketItem("breeze_rod", breeze rod, "&bBreeze Rod", 1, 60, 16, 33, true)
    marketItem("wither_skull", wither skeleton skull, "&8Wither Skeleton Skull", 1, 1000, 3, 34, true)
    marketItem("oak_log", oak log, "&6Oak Log", 1, 2, 64, 0, false)
    marketItem("netherite_scrap", netherite scrap, "&8Netherite Scrap", 1, 500, 8, 37, true)
    marketItem("gunpowder", gunpowder, "&7Gunpowder", 1, 5, 64, 38, true)
    marketItem("leather", leather, "&6Leather", 1, 8, 64, 0, false)
    marketItem("glowstone", glowstone, "&eGlowstone", 1, 10, 64, 39, true)
    marketItem("cobweb", cobweb, "&fCobweb", 1, 25, 32, 40, true)
    marketItem("piston", piston, "&7Piston", 1, 30, 16, 41, true)
    marketItem("dragon_breath", dragon breath, "&dDragon's Breath", 1, 400, 8, 42, true)
    marketItem("ominous_key", ominous trial key, "&5Ominous Trial Key", 1, 2500, 2, 43, true)

function rank(id: text, name: text, mult: number, price: text, icon: itemtype):
    add {_id} to {cfg::rank::ids::*}
    set {cfg::rank::%{_id}%::name} to {_name}
    set {cfg::rank::%{_id}%::mult} to {_mult}
    set {cfg::rank::%{_id}%::price} to {_price}
    set {cfg::rank::%{_id}%::icon} to {_icon}

function marketItem(id: text, item: itemtype, name: text, amount: integer, price: number, stock: integer, slot: integer, enabled: boolean):
    add {_id} to {market::ids::*}
    set {market::%{_id}%::item} to {_item}
    set {market::%{_id}%::name} to {_name}
    set {market::%{_id}%::amount} to {_amount}
    set {market::%{_id}%::price} to {_price}
    set {market::%{_id}%::stock} to {_stock}
    set {market::%{_id}%::slot} to {_slot}
    set {market::%{_id}%::enabled} to {_enabled}


# ============================================================
#  ECONOMY - persistent balances + /balance, /pay, /eco
#  Balances are stored in {economy::balance::<uuid>}.
# ============================================================

# Chat prefix from settings.sk
function pre() :: text:
    if {cfg::prefix} is set:
        return {cfg::prefix}
    return "» "

# 504363 -> "$504,363"
function money(n: number) :: text:
    set {_c} to {cfg::currency} ? "$"
    return "%{_c}%%commas({_n})%"

function commas(n: number) :: text:
    set {_s} to "%rounded down abs({_n})%"
    set {_len} to length of {_s}
    set {_out} to ""
    loop {_len} times:
        set {_i} to {_len} - loop-number + 1
        set {_out} to "%subtext of {_s} from characters {_i} to {_i}%%{_out}%"
        if mod(loop-number, 3) = 0:
            if loop-number < {_len}:
                set {_out} to ",%{_out}%"
    if {_n} < 0:
        return "-%{_out}%"
    return {_out}

# "2500", "2.5k", "1m", "3b" -> number (none if invalid)
function parseAmount(t: text) :: number:
    set {_t} to lowercase {_t}
    replace all "," in {_t} with ""
    replace all "$" in {_t} with ""
    set {_mult} to 1
    if {_t} ends with "k":
        set {_mult} to 1000
    else if {_t} ends with "m":
        set {_mult} to 1000000
    else if {_t} ends with "b":
        set {_mult} to 1000000000
    if {_mult} > 1:
        set {_t} to first (length of {_t} - 1) characters of {_t}
    set {_n} to {_t} parsed as number
    {_n} is set
    return rounded down ({_n} * {_mult})

function getBalance(p: offline player) :: number:
    return {economy::balance::%uuid of {_p}%} ? 0

function setBalance(p: offline player, n: number):
    set {economy::balance::%uuid of {_p}%} to max(0, rounded down {_n})

function addBalance(p: offline player, n: number):
    setBalance({_p}, getBalance({_p}) + {_n})

on join:
    if {economy::balance::%uuid of player%} is not set:
        setBalance(player, {cfg::starting-balance} ? 0)

command /balance [<offline player>]:
    aliases: /bal, /money
    trigger:
        set {_t} to arg-1 ? player
        if {_t} is not set:
            send "%pre()%&cUsage: /balance <player>"
            stop
        set {_all::*} to sorted indices of {economy::balance::*} in descending order
        loop {_all::*}:
            if loop-value is uuid of {_t}:
                set {_rank} to loop-index
        send "&8&m                              "
        send " <##00D6FF>&l%{_t}%'s Balance"
        send " &8▪ &fMoney: &a%money(getBalance({_t}))%"
        if {_rank} is not set:
            set {_rank} to "-"
        send " &8▪ &fRank: &e#%{_rank}%  &7(/baltop)"
        send "&8&m                              "

command /pay <player> <text>:
    usage: &cUsage: /pay <player> <amount>  &7(e.g. 500, 2.5k, 1m)
    trigger:
        set {_amt} to parseAmount(arg-2)
        if {_amt} is not set:
            send "%pre()%&cInvalid amount. Examples: &f500&c, &f2.5k&c, &f1m"
            stop
        if {_amt} <= 0:
            send "%pre()%&cAmount must be at least 1."
            stop
        # Vanished staff: act exactly like the player isn't online (StaffVanish hides them from this player)
        if player can't see arg-1:
            send "%pre()%&cNo player was found."
            stop
        if arg-1 is player:
            send "%pre()%&cYou can't pay yourself."
            stop
        if getBalance(player) < {_amt}:
            send "%pre()%&cYou only have &f%money(getBalance(player))%&c."
            stop
        addBalance(player, 0 - {_amt})
        addBalance(arg-1, {_amt})
        send "%pre()%&a&l$ &7You sent &a%money({_amt})% &7to &f%arg-1%&7."
        play sound "entity.experience_orb.pickup" to player
        send "%pre()%&a&l$ &7You received &a%money({_amt})% &7from &f%player%&7." to arg-1
        send title "&a+%money({_amt})%" with subtitle "&7from &f%player%" to arg-1 for 2 seconds
        play sound "entity.player.levelup" to arg-1

command /eco <text> <offline player> <text>:
    permission: economy.admin
    usage: &cUsage: /eco <give|take|set> <player> <amount>
    trigger:
        set {_amt} to parseAmount(arg-3)
        if {_amt} is not set:
            send "%pre()%&cInvalid amount."
            stop
        if arg-1 is "give":
            addBalance(arg-2, {_amt})
        else if arg-1 is "take":
            addBalance(arg-2, 0 - {_amt})
        else if arg-1 is "set":
            setBalance(arg-2, {_amt})
        else:
            send "%pre()%&cUsage: /eco <give|take|set> <player> <amount>"
            stop
        loop all players:
            if loop-player is arg-2:
                send "%pre()%&7An admin updated your balance: &a%money(getBalance(arg-2))%" to loop-player
        send "%pre()%&a%arg-2%'s balance is now %money(getBalance(arg-2))%."


# ============================================================
#  SCOREBOARD - sidebar with money, playtime, kills, deaths, IP
#  Requires SkBee.
# ============================================================

# Playtime is counted in minutes in {economy::playtime::<uuid>}
every 1 minute:
    loop all players:
        add 1 to {economy::playtime::%uuid of loop-player%}

function fmtPlaytime(m: number) :: text:
    set {_h} to floor({_m} / 60)
    set {_min} to mod({_m}, 60)
    return "%{_h}%h %{_min}%m"

function updateBoard(p: player):
    set {_u} to uuid of {_p}
    set {_money} to money(getBalance({_p}))
    set {_time} to fmtPlaytime({economy::playtime::%{_u}%} ? 0)
    set {_kills} to {economy::kills::%{_u}%} ? 0
    set {_deaths} to {economy::deaths::%{_u}%} ? 0
    set {_ip} to {cfg::server-ip} ? "85.10.193.117:25427"

    set title of {_p}'s fastboard to {cfg::title} ? "&b&lᴠᴀɴɪʟʟᴀ sᴍᴘ"
    set line 9 of {_p}'s fastboard to "&7&m                    "
    set line 8 of {_p}'s fastboard to "&fMoney: &a%{_money}%"
    set line 7 of {_p}'s fastboard to "&fPlaytime: &e%{_time}%"
    set line 6 of {_p}'s fastboard to "&r"
    set line 5 of {_p}'s fastboard to "&fKills: &a%{_kills}%"
    set line 4 of {_p}'s fastboard to "&fDeaths: &c%{_deaths}%"
    set line 3 of {_p}'s fastboard to "&r&r"
    set line 2 of {_p}'s fastboard to "&7&m                    &r"
    set line 1 of {_p}'s fastboard to "&6%{_ip}%"

on join:
    wait 1 tick
    updateBoard(player)

every 2 seconds:
    loop all players:
        updateBoard(loop-player)


# ============================================================
#  KILL REWARDS - money for mob/player kills, kill & death stats
#  Rewards are set in settings.sk.
# ============================================================

# Player's kill-money multiplier: the bought rank, or smp.rank.<id> permission. Highest wins.
function multiplier(p: player) :: number:
    set {_best} to 1
    loop {cfg::rank::ids::*}:
        set {_m} to {cfg::rank::%loop-value%::mult}
        if {economy::rank::%uuid of {_p}%} is loop-value:
            set {_best} to max({_best}, {_m})
        else if {_p} has permission "smp.rank.%loop-value%":
            set {_best} to max({_best}, {_m})
    return {_best}

on death:
    if victim is a player:
        add 1 to {economy::deaths::%uuid of victim%}
        attacker is a player
        attacker is not victim
        add 1 to {economy::kills::%uuid of attacker%}

        set {_reward} to ({cfg::player-kill-reward} ? 0) * multiplier(attacker)
        if {_reward} > 0:
            addBalance(attacker, {_reward})
            send action bar "&a+%money({_reward})% &7for killing &f%victim%" to attacker

        set {_penalty} to min({cfg::player-death-penalty} ? 0, getBalance(victim))
        if {_penalty} > 0:
            addBalance(victim, 0 - {_penalty})
            send "%pre()%&cYou lost %money({_penalty})% to %attacker%." to victim
    else:
        attacker is a player
        set {_reward} to ({mobreward::%type of victim%} ? 0) * multiplier(attacker)
        if {_reward} > 0:
            addBalance(attacker, {_reward})
            if multiplier(attacker) > 1:
                send action bar "&a+%money({_reward})% &7for killing a &f%type of victim% &8(&e%multiplier(attacker)%x&8)" to attacker
            else:
                send action bar "&a+%money({_reward})% &7for killing a &f%type of victim%" to attacker


# ============================================================
#  MARKET - /market GUI shop with an hourly reset
#  Items, prices, stock and reset time are set in settings.sk.
#
#  Layout (6 rows): items in rows 2-5 (30 items), clock with the reset
#  countdown in the bottom middle, lime glass either side.
# ============================================================

# ---------- helpers ----------

function fmtDuration(s: number) :: text:
    set {_t} to max(0, floor({_s}))
    set {_h} to floor({_t} / 3600)
    set {_m} to floor(mod({_t}, 3600) / 60)
    set {_sec} to mod({_t}, 60)
    if {_h} > 0:
        return "%{_h}%h %{_m}%m %{_sec}%s"
    return "%{_m}%m %{_sec}%s"

# Purchases left this reset, or -1 for unlimited
function stockLeft(id: text) :: number:
    set {_max} to {market::%{_id}%::stock} ? -1
    if {_max} < 0:
        return -1
    return max(0, {_max} - ({marketstate::sold::%{_id}%} ? 0))

# ---------- reset / rotation ----------

function pickRotation():
    delete {marketstate::shown::*}
    loop {market::ids::*}:
        if {market::%loop-value%::enabled} is true:
            add loop-value to {_pool::*}
    set {_pool::*} to shuffled {_pool::*}
    set {_n} to min(28, {cfg::market-rotate-count} ? 28)
    set {_i} to 0
    loop {_pool::*}:
        add 1 to {_i}
        if {_i} <= {_n}:
            add loop-value to {marketstate::shown::*}

function resetMarket():
    set {marketstate::next-reset} to (unix timestamp of now) + ({cfg::market-reset-minutes} ? 60) * 60
    delete {marketstate::sold::*}
    pickRotation()
    if {cfg::market-reset-message} is set:
        broadcast {cfg::market-reset-message}
    refreshAllMarkets()

# ---------- GUI ----------

function updateClock(p: player, gui: inventory):
    set {_left} to ({marketstate::next-reset} ? 0) - (unix timestamp of now)
    set {_avail} to 0
    loop {-market::slot::%uuid of {_p}%::*}:
        if stockLeft(loop-value) is not 0:
            add 1 to {_avail}
    set slot 49 of {_gui} to clock named "&a&lMarket Info" with lore "&8▪ &fRestocks in &a%fmtDuration({_left})%", "&8▪ &fItems available: &a%{_avail}%", "&r", "&8▪ &fBalance: &a%money(getBalance({_p}))%" and "&8▪ &fRank multiplier: &a%multiplier({_p})%x"

function fillMarket(p: player, gui: inventory):
    set {_u} to uuid of {_p}
    delete {-market::slot::%{_u}%::*}
    set slots (integers between 0 and 53) of {_gui} to gray stained glass pane named "&r"
    set slot 48 of {_gui} to lime stained glass pane named "&r"
    set slot 50 of {_gui} to lime stained glass pane named "&r"

    # Which items to show, and where
    set {_grid::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, 25, 28, 29, 30, 31, 32, 33, 34, 37, 38, 39, 40, 41, 42 and 43
    set {_i} to 0
    if {cfg::market-rotate} is true:
        loop {marketstate::shown::*}:
            if {market::%loop-value%::enabled} is true:
                add 1 to {_i}
                if {_i} <= 28:
                    set {_show::%{_grid::%{_i}%}%} to loop-value
    else:
        loop {market::ids::*}:
            if {market::%loop-value%::enabled} is true:
                # items may only sit in the inner grid, never on the glass border
                if {_grid::*} contains {market::%loop-value%::slot}:
                    set {_show::%{market::%loop-value%::slot}%} to loop-value

    set {_bal} to getBalance({_p})
    loop {_show::*}:
        set {_slot} to loop-index parsed as integer
        set {_id} to loop-value
        set {_price} to {market::%{_id}%::price}
        set {_amt} to {market::%{_id}%::amount}
        set {_left} to stockLeft({_id})
        if {_left} is -1:
            set {_stock} to "&8▪ &fStock: &f∞"
        else:
            set {_stock} to "&8▪ &fStock: &f%commas({_left})%"
        if {_left} is 0:
            set {_status} to "&c» Sold out"
        else if {_bal} >= {_price}:
            set {_status} to "&e» Click to buy"
        else:
            set {_status} to "&c» Not enough money"
        set {_item} to {_amt} of {market::%{_id}%::item}
        set slot {_slot} of {_gui} to {_item} named {market::%{_id}%::name} with lore "&8▪ &fPrice: &a%money({_price})%", "&8▪ &fAmount: &f%{_amt}%x", {_stock}, "&r" and {_status}
        set {-market::slot::%{_u}%::%{_slot}%} to {_id}
    updateClock({_p}, {_gui})

on load:
    delete {-market::cd::*}
    delete {-market::buying::*}

function openMarket(p: player):
    set {_gui} to chest inventory with 6 rows named ({cfg::market-title} ? "&2&lᴍᴀʀᴋᴇᴛ")
    fillMarket({_p}, {_gui})
    # "-" prefix = memory only, never saved to disk
    set {-market::gui::%uuid of {_p}%} to {_gui}
    delete {-market::buying::%uuid of {_p}%}
    # Flag is set BEFORE opening so clicks are blocked from the very first tick
    set {-market::opening::%uuid of {_p}%} to true
    set {-market::open::%uuid of {_p}%} to true
    open {_gui} to {_p}
    wait 2 ticks
    delete {-market::opening::%uuid of {_p}%}

function refreshAllMarkets():
    loop all players:
        set {_gui} to {-market::gui::%uuid of loop-player%}
        if {_gui} is set:
            if {-market::open::%uuid of loop-player%} is set:
                fillMarket(loop-player, {_gui})

function buyItem(p: player, id: text):
    set {_left} to stockLeft({_id})
    if {_left} is 0:
        send "%pre()%&cThat item is sold out. It restocks in %fmtDuration(({marketstate::next-reset} ? 0) - (unix timestamp of now))%." to {_p}
        play sound "entity.villager.no" to {_p}
        stop
    set {_price} to {market::%{_id}%::price}
    if getBalance({_p}) < {_price}:
        send "%pre()%&cYou need &f%money({_price} - getBalance({_p}))% &cmore to buy that item." to {_p}
        play sound "entity.villager.no" to {_p}
        stop
    set {_item} to {market::%{_id}%::amount} of {market::%{_id}%::item}
    if {_p} can't hold {_item}:
        send "%pre()%&cYour inventory is full." to {_p}
        stop
    addBalance({_p}, 0 - {_price})
    if {_left} > 0:
        add 1 to {marketstate::sold::%{_id}%}
    give {_item} to {_p}
    send "%pre()%&aBought %{market::%{_id}%::amount}%x %{market::%{_id}%::name}% &afor %money({_price})%." to {_p}
    play sound "entity.experience_orb.pickup" to {_p}

# ---------- events ----------

command /market:
    aliases: /shop
    trigger:
        openMarket(player)

# Reset check + live countdown on the clock
every 1 second:
    if {marketstate::next-reset} is not set:
        resetMarket()
    else if (unix timestamp of now) >= {marketstate::next-reset}:
        resetMarket()
    else if {cfg::market-rotate} is true:
        if size of {marketstate::shown::*} is 0:
            pickRotation()
    loop all players:
        set {_gui} to {-market::gui::%uuid of loop-player%}
        if {_gui} is set:
            if {-market::open::%uuid of loop-player%} is set:
                updateClock(loop-player, {_gui})

on inventory click:
    {-market::open::%uuid of player%} is set
    # Block every click (shift-click, hotbar swap, double-click...) while the market is open
    cancel event
    # Clicks in the player's own inventory do nothing
    event-inventory is not player's inventory
    set {_slot} to index of event-slot
    set {_id} to {-market::slot::%uuid of player%::%{_slot}%}
    {_id} is set
    # One purchase per click: ignore the duplicate click events a double-click sends (2 ticks)
    {-market::buying::%uuid of player%} is not set
    set {-market::buying::%uuid of player%} to true
    buyItem(player, {_id})
    refreshAllMarkets()
    wait 2 ticks
    delete {-market::buying::%uuid of player%}

on inventory drag:
    set {_gui} to {-market::gui::%uuid of player%}
    {_gui} is set
    {-market::open::%uuid of player%} is set
    cancel event

on inventory close:
    {-market::open::%uuid of player%} is set
    # ignore the close of the previous menu that fires while the market opens
    {-market::opening::%uuid of player%} is not set
    delete {-market::open::%uuid of player%}
    delete {-market::gui::%uuid of player%}
    delete {-market::slot::%uuid of player%::*}

on quit:
    delete {-market::buying::%uuid of player%}
    delete {-market::open::%uuid of player%}
    delete {-market::gui::%uuid of player%}
    delete {-market::slot::%uuid of player%::*}

# ---------- admin ----------
# /marketadmin list
# /marketadmin reset
# /marketadmin toggle <id>
# /marketadmin price <id> <amount>
# /marketadmin stock <id> <amount>   (-1 = unlimited)
# In-game edits last until the next reload/restart - edit settings.sk to make them permanent.
command /marketadmin <text> [<text>] [<number>]:
    permission: economy.admin
    usage: &cUsage: /marketadmin <list|reset|toggle|price|stock> [id] [value]
    trigger:
        if arg-1 is "list":
            loop {market::ids::*}:
                send "%pre()%&e%loop-value% &7- %money({market::%loop-value%::price})% - stock %{market::%loop-value%::stock}% - enabled: %{market::%loop-value%::enabled}%"
            send "%pre()%&7Next reset in &f%fmtDuration(({marketstate::next-reset} ? 0) - (unix timestamp of now))%"
            stop
        if arg-1 is "reset":
            resetMarket()
            send "%pre()%&aMarket reset."
            stop
        if {market::%arg-2%::item} is not set:
            send "%pre()%&cUnknown item id. Use /marketadmin list"
            stop
        if arg-1 is "toggle":
            if {market::%arg-2%::enabled} is true:
                set {market::%arg-2%::enabled} to false
            else:
                set {market::%arg-2%::enabled} to true
            send "%pre()%&e%arg-2% enabled: %{market::%arg-2%::enabled}%"
        else if arg-1 is "price":
            if arg-3 is not set:
                send "%pre()%&cUsage: /marketadmin price <id> <amount>"
                stop
            set {market::%arg-2%::price} to max(0, arg-3)
            send "%pre()%&e%arg-2% price is now %money(arg-3)%"
        else if arg-1 is "stock":
            if arg-3 is not set:
                send "%pre()%&cUsage: /marketadmin stock <id> <amount>"
                stop
            set {market::%arg-2%::stock} to rounded down arg-3
            send "%pre()%&e%arg-2% stock is now %rounded down arg-3%"
        else:
            send "%pre()%&cUsage: /marketadmin <list|reset|toggle|price|stock> [id] [value]"
            stop
        refreshAllMarkets()


# ============================================================
#  BALTOP - /baltop GUI with player heads (21 per page)
# ============================================================

function openBaltop(p: player, page: integer):
    set {_all::*} to sorted indices of {economy::balance::*} in descending order
    set {_pages} to max(1, ceil(size of {_all::*} / 21))
    set {_page} to min(max(1, {_page}), {_pages})

    set {_gui} to chest inventory with 6 rows named "&8&lʙᴀʟᴀɴᴄᴇ ᴛᴏᴘ"
    set slots (integers between 0 and 53) of {_gui} to black stained glass pane named "&r"
    set slots 45, 46, 47, 51 and 52 of {_gui} to lime stained glass pane named "&r"

    set {_grid::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, 25, 28, 29, 30, 31, 32, 33 and 34
    loop 21 times:
        set {_rank} to ({_page} - 1) * 21 + loop-number
        set {_uuid} to {_all::%{_rank}%}
        if {_uuid} is set:
            set {_op} to {_uuid} parsed as offline player
            set {_head} to skull of {_op}
            if {_rank} is 1:
                set {_c} to "&6"
            else if {_rank} is 2:
                set {_c} to "&f"
            else if {_rank} is 3:
                set {_c} to "&c"
            else:
                set {_c} to "&a"
            set slot {_grid::%loop-number%} of {_gui} to {_head} named "%{_c}%#%{_rank}% &f%{_op}% &7→ &a%money({economy::balance::%{_uuid}%})%" with lore "&8▪ &fKills: &a%{economy::kills::%{_uuid}%} ? 0%" and "&8▪ &fDeaths: &c%{economy::deaths::%{_uuid}%} ? 0%"

    # Your own rank
    set {_me} to uuid of {_p}
    loop {_all::*}:
        if loop-value is {_me}:
            set {_myrank} to loop-index
    if {_myrank} is not set:
        set {_myrank} to "?"
    set slot 49 of {_gui} to {_p}'s skull named "&e&lYou &7- &f#%{_myrank}%" with lore "&8▪ &fBalance: &a%money(getBalance({_p}))%" and "&8▪ &fPage: &f%{_page}%/%{_pages}%"
    if {_page} > 1:
        set slot 48 of {_gui} to arrow named "&e« Previous page"
    if {_page} < {_pages}:
        set slot 50 of {_gui} to arrow named "&eNext page »"
    set slot 53 of {_gui} to barrier named "&cClose"

    set {-baltop::gui::%{_me}%} to {_gui}
    set {-baltop::page::%{_me}%} to {_page}
    set {-baltop::opening::%{_me}%} to true
    set {-baltop::open::%{_me}%} to true
    open {_gui} to {_p}
    wait 2 ticks
    delete {-baltop::opening::%{_me}%}

command /baltop [<integer>]:
    aliases: /balancetop, /moneytop
    trigger:
        openBaltop(player, arg-1 ? 1)

on inventory click:
    set {_gui} to {-baltop::gui::%uuid of player%}
    {_gui} is set
    {-baltop::open::%uuid of player%} is set
    cancel event
    set {_slot} to raw index of event-slot
    set {_page} to {-baltop::page::%uuid of player%}
    if {_slot} is 48:
        openBaltop(player, {_page} - 1)
    else if {_slot} is 50:
        openBaltop(player, {_page} + 1)
    else if {_slot} is 53:
        close player's inventory

on inventory drag:
    set {_gui} to {-baltop::gui::%uuid of player%}
    {_gui} is set
    {-baltop::open::%uuid of player%} is set
    cancel event

on inventory close:
    {-baltop::open::%uuid of player%} is set
    {-baltop::opening::%uuid of player%} is not set
    delete {-baltop::open::%uuid of player%}
    delete {-baltop::gui::%uuid of player%}

on quit:
    delete {-baltop::open::%uuid of player%}
    delete {-baltop::gui::%uuid of player%}
    delete {-baltop::page::%uuid of player%}


# ============================================================
#  RANKS - /ranks shows the kill-money ranks. They can't be bought
#  with in-game money: give them with /setrank or smp.rank.<id>.
# ============================================================

function openRanks(p: player):
    set {_gui} to chest inventory with 3 rows named "&8&lʀᴀɴᴋѕ"
    set slots (integers between 0 and 26) of {_gui} to gray stained glass pane named "&r"
    set {_u} to uuid of {_p}
    delete {-ranks::slot::%{_u}%::*}
    set {_slots::*} to 11, 15 and 13
    set {_i} to 0
    loop {cfg::rank::ids::*}:
        add 1 to {_i}
        set {_id} to loop-value
        set {_slot} to {_slots::%{_i}%}
        if {economy::rank::%{_u}%} is {_id}:
            set {_status} to "&a✔ You own this rank"
        else if multiplier({_p}) >= {cfg::rank::%{_id}%::mult}:
            set {_status} to "&7You already have an equal or better rank"
        else:
            set {_status} to "&e» Buy at &f%{cfg::store-url}%"
        set slot {_slot} of {_gui} to {cfg::rank::%{_id}%::icon} named {cfg::rank::%{_id}%::name} with lore "&8▪ &fKill money: &a%{cfg::rank::%{_id}%::mult}%x", "&8▪ &fPrice: &a%{cfg::rank::%{_id}%::price}%", "&8▪ &fLasts: &aForever", "&r" and {_status}
        set {-ranks::slot::%{_u}%::%{_slot}%} to {_id}
    set slot 22 of {_gui} to clock named "&a&lYour Multiplier" with lore "&8▪ &fCurrent: &a%multiplier({_p})%x" and "&8▪ &fBalance: &a%money(getBalance({_p}))%"
    set {-ranks::opening::%{_u}%} to true
    set {-ranks::open::%{_u}%} to true
    open {_gui} to {_p}
    wait 2 ticks
    delete {-ranks::opening::%{_u}%}

command /ranks:
    aliases: /rank, /buyrank
    trigger:
        openRanks(player)

on inventory click:
    {-ranks::open::%uuid of player%} is set
    cancel event
    event-inventory is not player's inventory
    set {_id} to {-ranks::slot::%uuid of player%::%index of event-slot%}
    {_id} is set
    close player's inventory
    send "%pre()%&7Ranks can't be bought with in-game money."
    send "%pre()%&7Get %{cfg::rank::%{_id}%::name}% &7at &f%{cfg::store-url}%"

on inventory drag:
    {-ranks::open::%uuid of player%} is set
    cancel event

on inventory close:
    {-ranks::open::%uuid of player%} is set
    {-ranks::opening::%uuid of player%} is not set
    delete {-ranks::open::%uuid of player%}

on quit:
    delete {-ranks::open::%uuid of player%}

# Admin: /setrank <player> <id|none>
command /setrank <offline player> <text>:
    permission: economy.admin
    trigger:
        if arg-2 is "none":
            delete {economy::rank::%uuid of arg-1%}
        else if {cfg::rank::%arg-2%::mult} is set:
            set {economy::rank::%uuid of arg-1%} to arg-2
        else:
            send "%pre()%&cUnknown rank. Ranks: %{cfg::rank::ids::*}%, none"
            stop
        send "%pre()%&aSet %arg-1%'s rank to %arg-2%."
        loop all players:
            if loop-player is arg-1:
                if arg-2 is not "none":
                    send title {cfg::rank::%arg-2%::name} with subtitle "&7You now earn &a%{cfg::rank::%arg-2%::mult}%x &7kill money!" to loop-player for 3 seconds
                    play sound "ui.toast.challenge_complete" to loop-player


# ============================================================
#  TELEPORTS - /tpa /tpahere /tpaccept /tpdeny /tpacancel /tptoggle
#              /rtp  /spawn  /setspawn
#  Settings are in settings.sk.
# ============================================================

# ---------- helpers ----------

function nowSec() :: number:
    return unix timestamp of now

# Seconds left on a cooldown (0 = ready)
function cooldownLeft(p: player, key: text) :: number:
    set {_until} to {-tp::cd::%uuid of {_p}%::%{_key}%}
    if {_until} is not set:
        return 0
    return max(0, ceil({_until} - nowSec()))

function setCooldown(p: player, key: text, secs: number):
    if {_p} has permission "smp.tp.bypass":
        stop
    set {-tp::cd::%uuid of {_p}%::%{_key}%} to nowSec() + {_secs}

# Teleports after standing still for the warmup. Moving cancels it.
function warmupTeleport(p: player, dest: location, what: text):
    set {_u} to uuid of {_p}
    set {_secs} to {cfg::tp-warmup}
    if {_secs} is not set:
        set {_secs} to 3
    if {_p} has permission "smp.tp.bypass":
        set {_secs} to 0
    add 1 to {-tp::warmup::%{_u}%}
    set {_id} to {-tp::warmup::%{_u}%}
    set {_start} to location of {_p}
    loop {_secs} times:
        send action bar "&eTeleporting to %{_what}% in &f%{_secs} - loop-number + 1%s &7- don't move!" to {_p}
        play sound "block.note_block.hat" to {_p}
        wait 1 second
        if {_p} is not online:
            stop
        # a newer teleport replaced this one
        if {-tp::warmup::%{_u}%} is not {_id}:
            stop
        if distance between location of {_p} and {_start} > 0.6:
            send action bar "&cTeleport cancelled - you moved." to {_p}
            play sound "entity.villager.no" to {_p}
            stop
    teleport {_p} to {_dest}
    send action bar "&aTeleported to %{_what}%!" to {_p}
    play sound "entity.enderman.teleport" to {_p}

# ---------- /tpa ----------

function sendTpa(from: player, to: player, here: boolean):
    if {_from} can't see {_to}:
        send "%pre()%&cNo player was found." to {_from}
        stop
    if {_from} is {_to}:
        send "%pre()%&cYou can't teleport to yourself." to {_from}
        stop
    if {tp::toggle::%uuid of {_to}%} is true:
        send "%pre()%&f%{_to}% &cisn't accepting teleport requests." to {_from}
        stop
    set {_cd} to cooldownLeft({_from}, "tpa")
    if {_cd} > 0:
        send "%pre()%&cWait &f%{_cd}%s &cbefore sending another request." to {_from}
        stop
    set {_t} to uuid of {_to}
    set {-tp::req::%{_t}%::from} to uuid of {_from}
    set {-tp::req::%{_t}%::here} to {_here}
    set {_exp} to {cfg::tpa-expire}
    if {_exp} is not set:
        set {_exp} to 60
    set {-tp::req::%{_t}%::expires} to nowSec() + {_exp}
    setCooldown({_from}, "tpa", {cfg::tpa-cooldown} ? 10)
    send "%pre()%&7Request sent to &f%{_to}%&7. It expires in &f%{_exp}%s&7. &8(/tpacancel)" to {_from}
    if {_here} is true:
        send "%pre()%&f%{_from}% &7wants &eyou &7to teleport &eto them&7." to {_to}
    else:
        send "%pre()%&f%{_from}% &7wants to teleport &eto you&7." to {_to}
    send "%pre()%&a/tpaccept &7to accept, &c/tpdeny &7to deny." to {_to}
    play sound "entity.experience_orb.pickup" to {_to}

command /tpa <player>:
    aliases: /tpask
    trigger:
        sendTpa(player, arg-1, false)

command /tpahere <player>:
    trigger:
        sendTpa(player, arg-1, true)

command /tpaccept:
    aliases: /tpyes
    trigger:
        set {_t} to uuid of player
        set {_fromU} to {-tp::req::%{_t}%::from}
        if {_fromU} is not set:
            send "%pre()%&cYou have no teleport requests."
            stop
        if nowSec() > {-tp::req::%{_t}%::expires}:
            delete {-tp::req::%{_t}%::*}
            send "%pre()%&cThat request expired."
            stop
        loop all players:
            if uuid of loop-player is {_fromU}:
                set {_from} to loop-player
        if {_from} is not set:
            delete {-tp::req::%{_t}%::*}
            send "%pre()%&cThat player is no longer online."
            stop
        set {_here} to {-tp::req::%{_t}%::here}
        delete {-tp::req::%{_t}%::*}
        send "%pre()%&aRequest accepted."
        send "%pre()%&f%player% &aaccepted your request." to {_from}
        if {_here} is true:
            warmupTeleport(player, location of {_from}, "%{_from}%")
        else:
            warmupTeleport({_from}, location of player, "%player%")

command /tpdeny:
    aliases: /tpno
    trigger:
        set {_t} to uuid of player
        set {_fromU} to {-tp::req::%{_t}%::from}
        if {_fromU} is not set:
            send "%pre()%&cYou have no teleport requests."
            stop
        delete {-tp::req::%{_t}%::*}
        send "%pre()%&7Request denied."
        loop all players:
            if uuid of loop-player is {_fromU}:
                send "%pre()%&f%player% &cdenied your teleport request." to loop-player

command /tpacancel:
    trigger:
        set {_me} to uuid of player
        loop all players:
            if {-tp::req::%uuid of loop-player%::from} is {_me}:
                delete {-tp::req::%uuid of loop-player%::*}
                set {_done} to true
        if {_done} is true:
            send "%pre()%&7Your teleport request was cancelled."
        else:
            send "%pre()%&cYou have no outgoing requests."

command /tptoggle:
    trigger:
        if {tp::toggle::%uuid of player%} is true:
            delete {tp::toggle::%uuid of player%}
            send "%pre()%&aYou now accept teleport requests."
        else:
            set {tp::toggle::%uuid of player%} to true
            send "%pre()%&cYou no longer accept teleport requests."

on quit:
    delete {-tp::req::%uuid of player%::*}

# ---------- /rtp ----------

command /rtp:
    aliases: /wild, /randomtp
    trigger:
        set {_cd} to cooldownLeft(player, "rtp")
        if {_cd} > 0:
            send "%pre()%&cYou can /rtp again in &f%fmtDuration({_cd})%&c."
            stop
        set {_w} to world({cfg::rtp-world} ? "world")
        if {_w} is not set:
            send "%pre()%&cThe RTP world isn't set up correctly. Tell an admin."
            stop
        set {_min} to {cfg::rtp-min} ? 500
        set {_max} to {cfg::rtp-max} ? 5000
        send action bar "&eFinding a safe spot..."
        loop 15 times:
            set {_r} to random number between {_min} and {_max}
            set {_a} to random number between 0 and 360
            set {_x} to round({_r} * cos({_a}))
            set {_z} to round({_r} * sin({_a}))
            set {_b} to highest solid block at location({_x}, 0, {_z}, {_w})
            if {_b} is set:
                set {_bad} to false
                if type of {_b} is water or lava or magma block or cactus or powder snow or fire or campfire:
                    set {_bad} to true
                if {_bad} is false:
                    set {_dest} to location({_x} + 0.5, y-coordinate of {_b} + 1, {_z} + 0.5, {_w})
                    exit loop
        if {_dest} is not set:
            send "%pre()%&cCouldn't find a safe spot. Try again."
            stop
        setCooldown(player, "rtp", {cfg::rtp-cooldown} ? 300)
        warmupTeleport(player, {_dest}, "a random location")
        send "%pre()%&7Heading to &f%rounded {_x}%, %rounded {_z}%&7."

# ---------- /spawn ----------

command /spawn:
    trigger:
        if {tp::spawn} is not set:
            send "%pre()%&cSpawn hasn't been set yet. Admins: stand there and use /setspawn."
            stop
        set {_cd} to cooldownLeft(player, "spawn")
        if {_cd} > 0:
            send "%pre()%&cWait &f%{_cd}%s &cbefore using /spawn again."
            stop
        setCooldown(player, "spawn", {cfg::spawn-cooldown} ? 5)
        warmupTeleport(player, {tp::spawn}, "spawn")

command /setspawn:
    permission: smp.admin.setspawn
    trigger:
        set {tp::spawn} to location of player
        send "%pre()%&aSpawn set to your location."

# New players and respawns without a bed go to spawn
on first join:
    {tp::spawn} is set
    wait 1 tick
    teleport player to {tp::spawn}

on respawn:
    {tp::spawn} is set
    bed of player is not set
    set respawn location to {tp::spawn}
